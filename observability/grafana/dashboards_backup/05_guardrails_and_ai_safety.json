{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Pre-LLM Security Firewall & Deterministic Policy Enforcement (<25ms SLA)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Security Inspection Latency (Target: <30ms SLA)",
      "description": "Deterministic policy evaluation latency executed prior to invoking LLMs. Target SLA is <30ms execution time.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(guardrail_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95 Guardrail Inspection (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 30 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Cumulative Exploits Intercepted",
      "description": "Total malicious threats intercepted over application lifetime (prompt injections, loan fraud, fake financial statements).",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(guardrail_blocks_total) or vector(0)", "legendFormat": "Blocked Threats" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "id": 3,
      "title": "Policy Enforcement (Lifetime)",
      "description": "Pre-LLM security decisions cumulative count. ALLOWED = prompt cleared for LLM inference; BLOCKED = threat intercepted before model execution.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 5, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(guardrail_actions_total{action=~\"(?i)allow.*\"}) or vector(0)",
          "legendFormat": "ALLOWED"
        },
        {
          "expr": "sum(guardrail_actions_total{action=~\"(?i)block.*\"}) or vector(0)",
          "legendFormat": "BLOCKED"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [
            { "options": { "ALLOWED": { "color": "green" }, "BLOCKED": { "color": "red" } }, "type": "value" }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ALLOWED" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "BLOCKED" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Recent Rehearsal Decisions (15m Window)",
      "description": "Recent observation window decisions (useful for capstone rehearsal runs to see immediate delta without restarting stack).",
      "type": "stat",
      "gridPos": { "h": 8, "w": 5, "x": 19, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "round(sum(increase(guardrail_actions_total{action=~\"(?i)allow.*\"}[15m]))) or vector(0)",
          "legendFormat": "ALLOWED (15m)"
        },
        {
          "expr": "round(sum(increase(guardrail_actions_total{action=~\"(?i)block.*\"}[15m]))) or vector(0)",
          "legendFormat": "BLOCKED (15m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [
            { "options": { "ALLOWED (15m)": { "color": "green" }, "BLOCKED (15m)": { "color": "red" } }, "type": "value" }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ALLOWED (15m)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "BLOCKED (15m)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Threat Vector Taxonomy & Classification (Fraud, Injections, Jailbreaks)",
      "type": "row"
    },
    {
      "id": 4,
      "title": "Blocked Attack Vectors by Threat Category",
      "description": "Categorical distribution of security threats caught by deterministic pre-LLM filters.",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(guardrail_blocks_total) by (guardrail_type)",
          "legendFormat": "{{guardrail_type}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80 }
        }
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.6,
        "groupWidth": 0.7
      }
    },
    {
      "id": 5,
      "title": "Live Threat Interception Rate (Events/min)",
      "description": "Frequency of security policy enforcement actions per minute.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(guardrail_actions_total{action=~\"(?i)block.*\"}[5m])) * 60",
          "legendFormat": "Threats Blocked / min"
        },
        {
          "expr": "sum(rate(guardrail_actions_total{action=~\"(?i)allow.*\"}[5m])) * 60",
          "legendFormat": "Safe Requests Allowed / min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Forensic Security Incident & Guardrail Logs (Loki)",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Security Attack Forensic Log Stream (Loki Ingestion)",
      "description": "Structured forensic log stream capturing threat details, correlation ID, and blocked prompt reasons.",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=~\".+\"} |= \"guardrail\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
