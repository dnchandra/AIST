# ===========================================================================
# Azure Container Apps configuration template (no secrets in this file).
#
# These are the same keys as backend/.env, expressed the way Azure Container
# Apps consumes them:
#   * plain values  -> container-app environment variables
#   * key/connection-string values -> Key Vault secret references
#
# All values, app names, and vault references are managed dynamically by
# deploy.config.json and scripts/azure_environment_setup.py.
# ===========================================================================

# --- Container runtime -----------------------------------------------------
# Must match the ingress target port and what uvicorn binds (Dockerfile CMD).
PORT=8080
LOG_LEVEL=INFO

# --- Data (Stage 1 baseline: container-local SQLite + documents) -----------
STORAGE_MODE=local
# Optional: point the SQLite file and uploaded documents at a mounted
# Azure Files volume so they survive revision restarts and new revisions.
# LOCAL_DATA_DIR=/mnt/loanapp-data

# --- Model provider: Azure OpenAI / Microsoft Foundry ----------------------
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://aiops-llm-api.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Never commit or bake the key. In Azure this is a Key Vault reference:
AZURE_OPENAI_API_KEY=secretref:azure-openai-api-key

# --- Monitoring (Application Insights) -------------------------------------
# Key Vault reference. Leave blank locally to log JSON to the console only.
APPLICATIONINSIGHTS_CONNECTION_STRING=secretref:appinsights-connection-string

# --- LangSmith Tracing (Opt-in; managed via langsmith_tracing_attach.py) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_BASE_URL=https://api.smith.langchain.com
LANGSMITH_PROJECT=AIOPS_Loan
LANGSMITH_API_KEY=secretref:langsmith-api-key
