    {
      "id": 16,
      "type": "gauge",
      "title": "Login Success Rate (SLO: \u2265 99.5%)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "clamp_max((sum(rate(auth_login_attempts_total{status=\"success\"}[15m])) or vector(1)) / (sum(rate(auth_login_attempts_total[15m])) > 0 or vector(1)) * 100, 100.0)",
          "legendFormat": "Login Success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 90,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 98.0
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          }
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Authentication Volume & Pass / Fail Stream (RPS)",
      "gridPos": {
        "x": 6,
        "y": 13,
        "w": 10,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(auth_login_attempts_total{status=\"success\"}[1m])",
          "legendFormat": "Pass (Success)",
          "refId": "A"
        },
        {
          "expr": "rate(auth_login_attempts_total{status=\"failure\"}[1m])",
          "legendFormat": "Fail (Rejected)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pass (Success)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fail (Rejected)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Fleet Microservice p95 Latencies (ms)",
      "gridPos": {
