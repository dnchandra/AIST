    {
      "id": 2,
      "type": "gauge",
      "title": "LoanProcessAI Availability SLI (Target: 99.9%)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "clamp_max((1 - (sum(rate(api_requests_total{status=~\"5..\"}[1h])) or vector(0)) / (sum(rate(api_requests_total[1h])) > 0 or vector(1))) * 100, 100)",
          "legendFormat": "Availability %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99.0
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Latency SLI: p95 < 500ms (Target: 99.0%)",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "clamp_max(100 - (histogram_quantile(0.95, sum(rate(api_request_duration_seconds_bucket[1h])) by (le)) or vector(0.04)) * 10, 100)",
          "legendFormat": "Latency Compliance %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 90,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
