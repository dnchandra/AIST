      "id": 2,
      "title": "Documents Complete",
      "description": "Applications that have completed document submission.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(loan_funnel_stage_total{stage=\"documents_complete\"}) or vector(0)", "legendFormat": "Docs Complete" }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }
      }
    },
    {
      "id": 3,
      "title": "KYC Passed",
      "description": "Applications that have passed KYC verification.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(loan_funnel_stage_total{stage=\"kyc_passed\"}) or vector(0)", "legendFormat": "KYC Passed" }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
      }
    },
    {
      "id": 4,
      "title": "Credit Approved",
      "description": "Applications approved by credit committee or automated underwriting.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(loan_funnel_stage_total{stage=\"credit_approved\",outcome=\"approved\"}) or vector(0)", "legendFormat": "Approved" }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
