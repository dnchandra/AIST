# Storage used on this laptop.
STORAGE_MODE=local

# -----------------------------------------------------------------------------
# MODE A: 100% LOCAL / AIR-GAPPED (Ollama + Elasticsearch + Grafana)
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ornith-1.5:35b
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:740m

SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=loanprocessai-rag
RAG_CANDIDATE_K=25
RAG_TOP_K=5

RERANKER_ENABLED=true
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

