      "type": "gauge",
      "title": "Error Budget Remaining (%)",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "clamp_min(100 - ((sum(rate(api_requests_total{status=~\"5..\"}[1h])) or vector(0)) / (sum(rate(api_requests_total[1h])) > 0 or vector(1)) / 0.001 * 100), 0)",
          "legendFormat": "Budget Remaining %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20.0
              },
              {
                "color": "green",
                "value": 50.0
              }
            ]
          }
        }
      }
    },
