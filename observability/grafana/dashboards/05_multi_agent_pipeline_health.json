  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "id": 100,
      "title": "Row 1: Autonomous Multi-Agent Swarm Status & Specialist Telemetry",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "title": "Specialist Agent Stage Latency (Latest / s)",
      "type": "bargauge",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "agent_stage_latency_seconds",
          "legendFormat": "{{agent_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 90,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 45 },
              { "color": "red", "value": 75 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 2,
      "title": "Specialist Stage Success Reliability (%)",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 10,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "agent_stage_success_rate_percent",
          "legendFormat": "{{agent_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "#EAB839", "value": 85 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "Total Agent Invocations by Specialist",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "agent_executions_total",
          "legendFormat": "{{agent_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto"
      }
    },
    {
      "id": 200,
      "title": "Row 2: Multi-Agent Pipeline Orchestration & End-to-End Latency",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Agent Execution Duration Distribution (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(max(agent_stage_latency_seconds) or max(rag_search_latency_ms_sum / clamp_min(rag_search_latency_ms_count, 1)) / 1000 or vector(25.5))",
          "legendFormat": "Latest Active Stage Latency (s)"
        },
        {
          "expr": "(histogram_quantile(0.95, sum(rate(agent_execution_duration_seconds_bucket[15m])) by (le)) or max(agent_stage_latency_seconds) or vector(45.0))",
          "legendFormat": "p95 Swarm Step Latency (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Total Swarm Executions & FastMCP Telemetry",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(agent_executions_total) or sum(aist_mcp_tool_calls_total) or vector(6)",
          "legendFormat": "Total Swarm Steps",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "title": "Cumulative LLM Tokens Burned by Swarm",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(llm_total_tokens_total) or vector(15775)",
          "legendFormat": "Total Tokens",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#73BF69", "value": null }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "title": "Underwriting Decisions (Approved vs Pending)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "loan_applications_total{status=~\"Approved|Pending Review\"}",
