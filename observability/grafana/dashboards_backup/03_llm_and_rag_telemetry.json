{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "RAG Retrieval & LLM Generation Latency Breakdown",
      "type": "row"
    },
    {
      "id": 1,
      "title": "RAG Search Latency (ES Dense Vector) vs LLM Generation Latency (ms)",
      "description": "Comparative latency: Elasticsearch dense vector retrieval vs LLM generative inference.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_search_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "RAG Vector Search Latency (p95 ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_model_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "LLM Generation Latency (p95 ms)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } }
      }
    },
    {
      "id": 2,
      "title": "Total LLM Invocations",
      "description": "Total model inference requests executed by status.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(llm_requests_total) by (status)",
          "legendFormat": "Status: {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "LLM Token Burn & Consumption Metrics (Multi-Agent Compounding Footprint)",
      "type": "row"
    },
    {
      "id": 3,
      "title": "Prompt Tokens (Input)",
      "description": "Compounding input tokens across 6 sequential agents (Intake -> KYC -> Financials -> Credit Memo -> Decision -> Closing) plus RAG context.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(llm_input_tokens_total)", "legendFormat": "Prompt Tokens" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "id": 4,
      "title": "Completion Tokens (Output)",
      "description": "Tokens generated by models for credit memo synthesis, financial spreading summaries, risk rationale, and facility letters.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(llm_output_tokens_total)", "legendFormat": "Completion Tokens" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }] }
        }
      }
    },
    {
      "id": 5,
      "title": "Total Tokens Burned",
      "description": "Total combined token footprint (input + completion) consumed across pipeline execution.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(llm_total_tokens_total)", "legendFormat": "Total Tokens" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 6,
      "title": "Token Burn Rate (Tokens/sec)",
      "description": "Live throughput of token generation during active underwriting runs.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(llm_total_tokens_total[1m]))", "legendFormat": "Tokens / sec" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 40 } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "LLM-as-a-Judge Evaluation & Groundedness Scores",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Hallucination Risk Score",
      "description": "Automated LLM-as-a-Judge evaluation evaluating factual consistency against retrieved credit policy documents (0 = zero hallucination, 5 = high risk).",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "evaluation_hallucination_risk_score", "legendFormat": "Risk Score" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 3.5 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "RAG & LLM Telemetry Stream (Loki Engine)",
      "description": "Audit stream of LLM completions, token consumption metadata, model latency, and prompt versions.",
      "type": "logs",
      "gridPos": { "h": 12, "w": 16, "x": 8, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=~\".+\"} |~ \"(?i)(rag|llm|agent)\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["loanprocessai", "rag", "llm", "tokens"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
