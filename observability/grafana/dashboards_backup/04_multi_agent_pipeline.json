      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(agent_executions_total) or vector(0)", "legendFormat": "Cumulative Steps" }
