      "id": 100,
      "title": "Row 1: Executive SLIs, Objectives & Multi-Window Error Budget Gauges",
      "type": "row"
    },
    {
      "id": 1,
      "title": "TicketFlow Availability SLI (Target: 99.9%)",
      "description": "Ratio of successful HTTP requests (non-5xx) over rolling 30m window.",
      "type": "gauge",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "clamp_max((sum(rate(http_requests_total{status!~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)) * 100, 100)",
          "legendFormat": "Availability %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 90,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99.0
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Latency SLI: p95 < 500ms (Target: 99.0%)",
      "description": "Percentage of requests completing within 500ms SLA target.",
      "type": "gauge",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "clamp_max((sum(rate(http_request_duration_seconds_bucket{le=\"0.5\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count[5m])), 0.001)) * 100, 100)",
          "legendFormat": "Fast Requests %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 80,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95.0
              },
              {
                "color": "green",
                "value": 99.0
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Error Budget Remaining (%)",
      "description": "Remaining monthly error budget based on 99.9% availability objective (0.1% allowable error).",
      "type": "gauge",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "clamp_min(clamp_max((1 - ((1 - (sum(rate(http_requests_total{status!~\"5..\"}[30m])) / clamp_min(sum(rate(http_requests_total[30m])), 0.001))) / 0.001)) * 100, 0), 100)",
          "legendFormat": "Budget Remaining %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 25.0
              },
              {
                "color": "green",
                "value": 75.0
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "1-Hour Error Budget Burn Rate",
      "description": "Google SRE MWMBR 1-hour burn rate. Values > 14.4x trigger P1 page.",
