        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU Load Percentage (%) Across Fleet",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "windows_cpu_load_percentage",
          "legendFormat": "Windows {{role}}",
          "refId": "A"
        },
        {
          "expr": "100 - (avg by (role) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "Linux {{role}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Physical Memory Utilization (%) Across Fleet",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "windows_os_memory_usage_ratio * 100",
          "legendFormat": "Windows {{role}}",
          "refId": "A"
        },
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "Linux {{role}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Row 4: Storage Capacity & Filesystem Free Space",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Logical Disk Free Space (GB)",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "windows_logical_disk_free_bytes{volume=\"C:\"} / 1073741824",
          "legendFormat": "Win {{os}} (C:)",
          "refId": "A"
        },
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"} / 1073741824",
          "legendFormat": "Linux {{os}} (/)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    }
