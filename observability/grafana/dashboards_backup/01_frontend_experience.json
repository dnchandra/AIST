{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Frontend Web Application Availability & Synthetic Probe",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Frontend Web Portal Status (Port 3000)",
      "description": "Real-time reachability status of the React Single Page Application (Port 3000).",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "frontend_up", "legendFormat": "Portal Status" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN / UNREACHABLE" }, "1": { "color": "green", "text": "ONLINE (200 OK)" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Frontend Availability SLA (Last 15m)",
      "description": "Average uptime compliance percentage of the frontend web application over 15 minutes.",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "avg_over_time(frontend_up[15m]) * 100", "legendFormat": "Availability %" }],
      "fieldConfig": {
        "defaults": {
          "min": 85,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 98 },
              { "color": "green", "value": 99.5 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Synthetic UI Probe Latency (ms)",
      "description": "Roundtrip HTTP synthetic health probe latency from backend to frontend.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "frontend_probe_duration_seconds * 1000", "legendFormat": "HTTP Probe Latency" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 500 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Web User Traffic & Portal Interaction Rates",
      "type": "row"
    },
    {
      "id": 4,
      "title": "Portal Interaction Request Rate (RPS by Route)",
      "description": "Inbound requests per second across user-facing loan portal endpoints.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{handler=~\".*application.*|.*process.*|/ask|/rag/ask\"}[5m])) by (handler)",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } }
      }
    },
    {
      "id": 5,
      "title": "Total Route Invocations (Last 15m)",
      "description": "Total user interactions categorized by API route.",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{handler=~\".*application.*|.*process.*|/ask|/rag/ask\"}[15m])) by (handler) or vector(0)",
          "legendFormat": "{{handler}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "palette-classic" } }
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.6,
        "groupWidth": 0.7
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Live Frontend Health & Probe Telemetry Stream (Loki)",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Frontend Health & API Gateway Probe Log Feed",
      "description": "Live ingestion feed of HTTP requests, health probes, and API gateway completions.",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=~\".+\"} |~ \"(?i)(metrics|healthz|readyz|cases|http)\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["loanprocessai", "frontend", "web-vitals"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "01 - Frontend Web Performance & Availability",
  "uid": "loanprocessai-frontend",
  "version": 2
}
