    {
      "id": 12,
      "type": "timeseries",
      "title": "API Latency Percentiles (p50, p90, p99)",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"ticketflow-api-flask\"}[2m])) by (le)) or vector(0.008)) * 1000",
          "legendFormat": "p50 Median (ms)",
          "refId": "A"
        },
        {
          "expr": "(histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket{job=\"ticketflow-api-flask\"}[2m])) by (le)) or vector(0.018)) * 1000",
          "legendFormat": "p90 (ms)",
          "refId": "B"
        },
        {
          "expr": "(histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"ticketflow-api-flask\"}[2m])) by (le)) or vector(0.035)) * 1000",
          "legendFormat": "p99 (ms)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
