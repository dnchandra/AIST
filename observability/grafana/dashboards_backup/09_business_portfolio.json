    },
    {
      "id": 5,
      "title": "Funded Volume ($)",
      "description": "Total funded loan volume in current period.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "loan_funded_volume_dollars or vector(0)", "legendFormat": "Funded Volume" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } }
      }
    },
    {
      "id": 6,
      "title": "Avg Days to Decision",
      "description": "Average days from application submission to final decision.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "avg_over_time(loan_time_to_decision_days[1h]) or vector(0)", "legendFormat": "Avg Days" }
