    },
    {
      "id": 4,
      "title": "Agent Stage Latency Breakdown (Average Execution Seconds)",
      "description": "Execution duration in seconds per autonomous agent stage.",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "agent_stage_latency_seconds or (sum(agent_execution_duration_seconds_sum) by (agent_name) / clamp_min(sum(agent_execution_duration_seconds_count) by (agent_name), 1))",
