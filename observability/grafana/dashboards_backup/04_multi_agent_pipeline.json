        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.6,
        "groupWidth": 0.7
      }
    },
    {
      "id": 5,
      "title": "Total Autonomous Agent Steps",
      "description": "Cumulative agent executions across all active lending cases.",
