# ==============================================================================
# AIST Environment Template (.env.example)
# Copy to .env and adjust variables as needed.
# ==============================================================================

# --- VMware vCenter & ESXi Hypervisor ---
VCENTER_HOST=192.168.1.220
VCENTER_USER=Administrator@vsphere.local
VCENTER_PASS=your_vcenter_password
ESXI_HOST=192.168.1.221
ESXI_USER=root
ESXI_PASS=your_esxi_password
DATASTORE_TARGET=Base_DS

# --- Multi-OS Node IPs ---
RHEL10_IP=192.168.1.130
RHEL9_IP=192.168.1.131
WIN2025_IP=192.168.1.132
WIN2019_IP=192.168.1.133
LOCAL_AI_HOST=192.168.1.16

# --- Operating System Authentication ---
LINUX_USER=root
LINUX_PASS=your_linux_password
WINDOWS_USER=Administrator
WINDOWS_PASS=your_windows_password

# --- Ports ---
TICKETFLOW_PORT=5000
NOTIFICATION_PORT=8080
AUTH_GATEWAY_PORT=5001
AUDIT_SERVICE_PORT=8088
NODE_EXPORTER_PORT=9100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
BACKEND_PORT=8000
FRONTEND_PORT=3001
# Comma-separated browser origins allowed to call the operator API.
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# --- Local AI Inference Engine ---
OLLAMA_HOST=http://127.0.0.1:11434
PRIMARY_LLM=ornith-1.5:35b
EMBEDDING_LLM=embeddinggemma-2:740m

