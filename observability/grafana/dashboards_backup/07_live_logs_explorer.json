  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Log Telemetry & Event Ingestion Volume",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Real-Time Ingestion Log Volume (Loki Streams)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\".+\"}[1m]))",
          "legendFormat": "Total Events / Min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }
      }
    },
    {
      "id": 2,
      "title": "Total Processed Log Entries",
      "type": "stat",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\".+\"}[15m]))",
          "legendFormat": "Last 15m Count"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "Live Structured Log Streams (Loki High-Performance Stream)",
      "type": "row"
    },
    {
      "id": 3,
      "title": "Live System & Agent Telemetry Stream (Loki Engine)",
      "type": "logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=~\".+\"}",
          "maxLines": 1000
        }
      ],
      "options": {
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 102,
      "title": "Historical Search & Distributed Trace Logs (Elasticsearch)",
      "type": "row"
    },
    {
      "id": 4,
      "title": "Elasticsearch Telemetry Logs (Full-Text Search & Audit Index)",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "elasticsearch", "uid": "Elasticsearch" },
      "targets": [
        {
          "query": "*",
          "metrics": [{ "type": "logs", "id": "1" }],
          "bucketAggs": [{ "type": "date_histogram", "id": "2", "settings": { "interval": "auto" }, "field": "@timestamp" }],
          "timeField": "@timestamp"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["loanprocessai", "logs", "loki", "elasticsearch"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
