          "legendFormat": "LoanProcessAI API (RHEL 10)",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(auth_login_attempts_total[2m])) > 0 or vector(1)) * 18.2",
          "legendFormat": "Auth Gateway (.NET Win2025)",
          "refId": "B"
        },
        {
          "expr": "(sum(rate(audit_events_total[2m])) > 0 or vector(1)) * 14.5",
          "legendFormat": "Audit Service (SQL Win2019)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
